# ==============================================================================
# LaunchPilot AI — Environment Configuration Template
# Copy this file to .env.local for local development
# NEVER commit real production credentials or private keys to git history.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Database & Authentication)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key for server-only administrative tasks
# WARNING: NEVER expose this key to browser bundles or client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# AI Provider Configuration (LLM Orchestration)
# ------------------------------------------------------------------------------
# If omitted or invalid, LaunchPilot AI gracefully activates its high-craft
# deterministic synthesizer with zero breakage.
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# Optional: Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
